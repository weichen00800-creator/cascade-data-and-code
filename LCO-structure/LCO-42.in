#----初始化----
units       metal    # 单位制
dimension   3        # 维度
boundary    p p p    # 边界条件
atom_style  atomic   # 原子类型
timestep  0.001
neighbor  0.3 bin
variable T0 equal 300 #室温
variable T1 equal 973 #退火温度

#----模拟区域信息设置---- 
lattice     bcc 3.2102 #晶格常数
region      box1 block 0 42 0 42 0 42 # 模拟区域大小=边界值30*晶格常数3.1 
create_box  3 box1 #设置原子种类
create_atoms 1 region box1 #向模拟区添加原子

# 原子类型转换
set type 1 type/ratio 2 0.3333333 123456
set type 1 type/ratio 3 0.5 654321

#---模拟环境中的原子信息
mass 1  47.867  #Ti
mass 2  50.9415  #V
mass 3  180.9  #Ta

#----力场/势函数---
pair_style nep
pair_coeff * * TiVTa.txt Ti V Ta

#保存模型
minimize  1e-10 1e-10 100000 100000 # 共轭梯度法最小化能量
write_data TiVTa_minimized.data      # 保存最小化后的结构

#设置输出信息/格式
thermo 100
thermo_style custom step lx ly lz press pxx pyy pzz pe temp etotal

#----加热过程（300K加热到973K）----
velocity all create ${T0} 87287 rot yes dist gaussian
fix rf all npt temp ${T0} ${T1} 0.1 iso 0.0 0.0 1.0
dump rd all custom 10000 rise.data id type x y z
run 100000
write_restart TiVTa_rise.restart
unfix rf
undump rd

#----弛豫（10 ps）----
velocity all create ${T1} 171997 units box
fix 0 all npt temp ${T1} ${T1} 0.1 iso 0 0 1
dump 1 all custom 10000 equil.data id type x y z
run 10000
write_restart equil.restart
unfix 0
undump 1
reset_timestep 0

#----MC/MD退火过程----
#MC (swap atoms)
fix 1 all nvt temp ${T1} ${T1} 0.1
fix 2 all atom/swap 100 10 223344 ${T1}  types 1 2
fix 3 all atom/swap 100 10 223344 ${T1}  types 1 3
fix 5 all atom/swap 100 10 223344 ${T1}  types 2 3
dump 2 all custom 5000 swaped.data id type x y z
restart 100000 restart.mcmd
run 50000000





