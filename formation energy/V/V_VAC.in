# LAMMPS脚本：TiVTa三元合金空位形成能计算
# 方法：使用元素的平均原子能量作为化学势，多位置采样
include vac_params.in

units       metal    # 单位制
dimension   3        # 维度
boundary    p p p    # 边界条件
atom_style  atomic   # 原子类型
lattice  bcc ${a0}   #晶格常数
timestep    0.001

# 读取完美晶体结构
read_data V_minimized.data

# 重新定义元素组
group V type 1

#----力场/势函数---
pair_style nep
pair_coeff * * TiVTa.txt V

region de sphere 5 5 5 0.1 units lattice
delete_atoms region de compress yes

#弛豫含空位结构
min_style cg
minimize 1.0e-8 1.0e-10 1000 10000
run 0

#打印结果
variable E_defect equal pe
variable Evf equal ${E_defect}-${E_perfect}+${mu_V}
print "Evf = ${Evf} eV" append V_VAC_eng.txt
